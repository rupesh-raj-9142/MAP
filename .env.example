# Server Port
PORT=3000

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yatra_db?schema=public"

# Authentication JWT Secret (min 32 characters)
AUTH_SECRET="yatra-super-secret-jwt-key-2026-production-ready"

# Google Maps Platform Keys
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# AI Provider Key (Gemini API or OpenAI compatible)
AI_API_KEY=""

# Mock Mode (Set to true to use realistic local data without external API keys or PostgreSQL)
USE_MOCK_DATA=true
